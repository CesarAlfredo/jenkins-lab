pipeline {
    agent any

    stages {
        stage('Validar GitHub') {
            steps {
                echo 'Codigo obtenido de GitHub'
            }
        }

        stage('Compilar') {
            steps {
                echo 'Simulando compilacion'
            }
        }

        stage('Finalizar') {
            steps {
                echo 'Pipeline terminado'
            }
        }
    }
}
